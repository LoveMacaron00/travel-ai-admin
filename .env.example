NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:7357,http://127.0.0.1:7357
ANALYTICS_TIME_ZONE=Asia/Bangkok
MEDIA_PROXY_HOSTS=dmc.tatdataapi.io,cdn.pixabay.com,images.unsplash.com
MEDIA_PROXY_TIMEOUT_MS=10000
MEDIA_PROXY_MAX_BYTES=12582912

GEMINI_API_BASE_URL=http://localhost:20128/v1
# ใส่ได้หลายโมเดลคั่นด้วย comma — ตัวหลักล่ม/โควต้าหมดจะสลับตัวถัดไปอัตโนมัติ
# ตัวอย่าง: GEMINI_MODEL=gemini/gemini-3.6-flash,gemini/gemini-3.8-flash,kr/auto
GEMINI_MODEL=gemini/gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_MAX_RETRIES=3
GEMINI_PLAN_THINKING_BUDGET=0
GEMINI_API_KEY=replace_with_your_9router_api_key

AIFORTHAI_OCR_API_KEY=replace_with_your_ocr_api_key
AIFORTHAI_TRANSLATE_API_KEY=replace_with_your_translate_api_key
AIFORTHAI_TFOOD_API_KEY=replace_with_your_tfood_api_key
AIFORTHAI_OCR_URL=https://api.aiforthai.in.th/ocr
AIFORTHAI_TRANSLATE_URL=https://api.aiforthai.in.th/xiaofan-en-th/th2en
AIFORTHAI_TFOOD_URL=https://api.aiforthai.in.th/thaifood

TAT_API_BASE_URL=https://tatdataapi.io/api/v2
TATDATAAPI=replace_with_your_tat_api_key

# Free web search แทน Gemini grounding (Tavily หลัก + Wikipedia/DuckDuckGo สำรอง)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDERS=tavily,wikipedia,duckduckgo
TAVILY_API_KEY=replace_with_your_tavily_api_key
TAVILY_SEARCH_DEPTH=basic
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_CACHE_TTL_MS=600000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=replace_with_a_strong_database_password
DB_NAME=smarttravel

ADMIN_JWT_SECRET=replace_with_a_long_random_admin_secret
USER_JWT_SECRET=replace_with_a_different_long_random_user_secret
